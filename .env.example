# =============================================================================
# AVELORA - Root Environment Configuration Template
# =============================================================================
# Copy this file to backend/.env and frontend/.env respectively.
# DO NOT COMMIT REAL CREDENTIALS OR API SECRETS TO GITHUB.
# =============================================================================

# --- Backend Configuration ---
NODE_ENV=production
PORT=3001
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/avelora_prod?retryWrites=true&w=majority
JWT_SECRET=your_long_random_secure_jwt_secret_key_here
FRONTEND_URL=https://avelora.com,https://www.avelora.com

# Cookie Settings (Lax for subdomain architecture e.g. avelora.com + api.avelora.com)
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=.avelora.com

# Initial Super Admin (Seeded on first initialization if database is empty)
INITIAL_ADMIN_EMAIL=admin@avelora.com
INITIAL_ADMIN_PASSWORD=your_strong_admin_password_here

# Cloudinary Cloud Storage (Optional - fallback to local base64 storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service Configuration (Resend or Gmail/SMTP)
RESEND_API_KEY=re_your_resend_api_key_here
MAIL_FROM="AVELORA Security" <onboarding@resend.dev>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password_here


# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=https://api.avelora.com
NEXT_PUBLIC_SITE_URL=https://avelora.com
