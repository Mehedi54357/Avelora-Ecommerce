# =============================================================================
# AVELORA - Backend Environment Configuration Template
# =============================================================================
# Set these environment variables in your hosting provider (Render / Railway / VPS)
# =============================================================================

NODE_ENV=production
PORT=3001

# MongoDB Atlas Database URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/avelora_prod?retryWrites=true&w=majority

# JWT Token Secret Key (Generate with: openssl rand -base64 32)
JWT_SECRET=your_long_random_secure_jwt_secret_key_here

# Frontend URL for CORS (comma-separated if multiple domains)
FRONTEND_URL=https://avelora.com,https://www.avelora.com

# Cookie Security Settings
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=.avelora.com

# Initial Super Admin Seed Credentials
INITIAL_ADMIN_EMAIL=admin@avelora.com
INITIAL_ADMIN_PASSWORD=your_strong_admin_password_here

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
