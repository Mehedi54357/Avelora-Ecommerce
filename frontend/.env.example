# =============================================================================
# AVELORA - Frontend Environment Configuration Template
# =============================================================================
# Set these environment variables in your hosting provider (Vercel)
# =============================================================================

# Public Backend API Gateway URL (without trailing slash)
# Local: http://localhost:3001
# Production: https://api.avelora.com
NEXT_PUBLIC_API_URL=https://api.avelora.com

# Public Storefront Canonical URL (for SEO, OpenGraph and Sitemap)
# Local: http://localhost:3000
# Production: https://avelora.com
NEXT_PUBLIC_SITE_URL=https://avelora.com
